# gemini-web2api configuration — .env is the single source of truth.
#
# Precedence: CLI flags > real env vars > .env file > built-in defaults.
# Copy this file to .env and edit. Values are optional — unset keys fall
# back to built-in defaults.

GEMINI_PORT=8081
GEMINI_HOST=0.0.0.0
GEMINI_RETRY_ATTEMPTS=3
GEMINI_RETRY_DELAY_SEC=2
GEMINI_REQUEST_TIMEOUT_SEC=180
GEMINI_BL=boq_assistant-bard-web-server_20260716.08_p0
# Account index from the signed-in Gemini URL, e.g. "1" for /u/1/app
# GEMINI_AUTH_USER=1
# Page XSRF token (SNlM0e) for authenticated requests
# GEMINI_XSRF_TOKEN=AOOh0P...
GEMINI_DEFAULT_MODEL=gemini-3.6-flash
GEMINI_LOG_REQUESTS=true
# Path to cookie file for Pro routing
# GEMINI_COOKIE_FILE=./cookie.txt
# HTTP proxy, e.g. http://127.0.0.1:7890
# GEMINI_PROXY=http://127.0.0.1:7890
# Single API key (takes precedence over GEMINI_API_KEYS).
# Set this when exposing the endpoint to the internet.
# NOTE: leave commented out when you configure keys elsewhere — an empty
# GEMINI_API_KEY= here would CLEAR those keys.
# GEMINI_API_KEY=sk-your-key
# Comma-separated API keys; empty disables authentication
# GEMINI_API_KEYS=sk-a,sk-b
# Fail-safe for public deployments: refuse to start when no keys are set
GEMINI_REQUIRE_AUTH=false
# Official Google AI Studio API key for /v1/embeddings. The Gemini web
# session (cookie) does NOT support embeddings, so this endpoint needs a
# separate API key from https://aistudio.google.com/apikey
# GEMINI_EMBEDDINGS_API_KEY=AIza...
# Gemini embedding model used for /v1/embeddings
# GEMINI_EMBEDDINGS_MODEL=text-embedding-004
# Override the Gemini web upstream base URL (default https://gemini.google.com).
# Mostly useful for tests / local mocks; leave unset in production.
# GEMINI_WEB_BASE=https://gemini.google.com
# Override the Google AI Studio API base URL used by /v1/embeddings.
# Mostly useful for tests / local mocks; leave unset in production.
# GEMINI_EMBEDDINGS_API_BASE=https://generativelanguage.googleapis.com
# Max runes per tool description injected into the prompt. Clients that send
# many tools (hermes sends 40+) can push the prompt past Gemini Web's
# anonymous size limit (~120KB), which upstream rejects with a silent
# BardErrorInfo [1152] -> content:null. Truncating descriptions keeps large
# tool sets working. 0 = unlimited. Default 150 (44 hermes tools -> ~110KB).
GEMINI_MAX_TOOL_DESC=150
# Dump the raw upstream Gemini response to /tmp/gemini-raw-empty.txt whenever
# a 200 arrives with no extractable text (diagnostics). Default false.
# GEMINI_DUMP_RAW=true
